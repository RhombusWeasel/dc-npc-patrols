<div class="dc-quest-editor editor-shell editor-shell-3col">
	<aside class="editor-panel editor-panel-assets">
		<header class="editor-panel-header">{{localize "dc-npc-patrols.quests.defs"}}</header>
		<div class="editor-panel-body">
			<div class="editor-asset-list">
				{{#each quest_defs}}
				<button type="button" class="editor-asset-item {{#if (eq this.id ../selected_def_id)}}active{{/if}}" data-quest-def-select="{{this.id}}">
					<span class="editor-asset-name">{{this.title}}</span>
					<button type="button" class="editor-asset-delete" data-quest-def-delete="{{this.id}}" title="{{localize 'dc-npc-patrols.quests.delete_def'}}">
						<i class="fa-solid fa-trash"></i>
					</button>
				</button>
				{{/each}}
				{{#unless quest_defs.length}}
				<div class="editor-panel-empty">{{localize "dc-npc-patrols.quests.no_defs"}}</div>
				{{/unless}}
			</div>
			<button type="button" class="editor-add-btn" data-action="quest-add-def">
				<i class="fa-solid fa-plus"></i> {{localize "dc-npc-patrols.quests.add_def"}}
			</button>
		</div>
		<footer class="editor-panel-footer">
			<p class="editor-hint">{{localize "dc-npc-patrols.hub.world_quests_hint"}}</p>
		</footer>
	</aside>

	<section class="editor-panel editor-panel-structure">
		<header class="editor-panel-header">
			<span>{{localize "dc-npc-patrols.quests.def_editor"}}</span>
			{{#if working_def}}<span class="editor-panel-subtitle">{{working_def.title}}</span>{{/if}}
		</header>
		<div class="editor-panel-body">
			{{#if working_def}}
			<label class="editor-field">
				<span>{{localize "dc-npc-patrols.quests.title"}}</span>
				<input type="text" data-quest-def-field="title" value="{{working_def.title}}" />
			</label>
			<label class="editor-field">
				<span>{{localize "dc-npc-patrols.quests.giver"}}</span>
				<input type="text" data-quest-def-field="giver" value="{{working_def.giver}}" />
			</label>
			<label class="editor-field">
				<span>{{localize "dc-npc-patrols.dialog.tree_desc"}}</span>
				<input type="text" data-quest-def-field="notes" value="{{working_def.notes}}" />
			</label>
			<label class="editor-field">
				<span>{{localize "dc-npc-patrols.quests.stages"}}</span>
				<textarea data-quest-def-field="stages" rows="5" placeholder="{{localize 'dc-npc-patrols.quests.stages_placeholder'}}">{{working_def.stages_text}}</textarea>
			</label>
			<div class="editor-subsection-title">{{localize "dc-npc-patrols.quests.vars"}}</div>
			{{#each working_def.vars}}
			<div class="dc-quest-var-row">
				<input type="text" data-quest-var-key="{{@index}}" value="{{this.key}}" placeholder="{{localize 'dc-npc-patrols.dialog.variable_key'}}" />
				<select data-quest-var-type="{{@index}}">
					<option value="text" {{#if (eq this.type "text")}}selected{{/if}}>Text</option>
					<option value="number" {{#if (eq this.type "number")}}selected{{/if}}>Number</option>
					<option value="boolean" {{#if (eq this.type "boolean")}}selected{{/if}}>Boolean</option>
				</select>
				<input type="text" data-quest-var-default="{{@index}}" value="{{this.default}}" placeholder="{{localize 'dc-npc-patrols.dialog.variable_default'}}" />
				<button type="button" class="editor-asset-delete" data-quest-var-delete="{{@index}}"><i class="fa-solid fa-trash"></i></button>
			</div>
			{{/each}}
			<button type="button" class="editor-add-btn editor-add-btn-inline" data-action="quest-add-var">
				<i class="fa-solid fa-plus"></i> {{localize "dc-npc-patrols.quests.add_var"}}
			</button>
			<button type="button" class="editor-add-btn dc-quest-save-btn" data-action="quest-save-def">
				<i class="fa-solid fa-floppy-disk"></i> {{localize "dc-npc-patrols.quests.save_def"}}
			</button>
			{{else}}
			<div class="editor-panel-empty">{{localize "dc-npc-patrols.quests.select_def_hint"}}</div>
			{{/if}}
		</div>
	</section>

	<section class="editor-panel editor-panel-detail">
		<header class="editor-panel-header">
			<span>{{localize "dc-npc-patrols.quests.posse_state"}}</span>
		</header>
		<div class="editor-panel-body">
			<label class="editor-field">
				<span>{{localize "dc-npc-patrols.quests.select_posse"}}</span>
				<select data-quest-posse-select>
					<option value="">{{localize "dc-npc-patrols.quests.select_posse"}}</option>
					{{#each posses}}
					<option value="{{this.id}}" {{#if (eq this.id ../selected_posse_id)}}selected{{/if}}>{{this.label}}</option>
					{{/each}}
				</select>
			</label>
			<div class="editor-asset-list">
				{{#each posse_quests}}
				<button type="button" class="editor-asset-item {{#if (eq this.id ../selected_posse_quest_id)}}active{{/if}}" data-posse-quest-select="{{this.id}}">
					<span class="editor-asset-name">{{this.title}}{{#if this.completed}} ✔{{/if}}</span>
					<button type="button" class="editor-asset-delete" data-posse-quest-delete="{{this.id}}" title="{{localize 'dc-npc-patrols.quests.delete_instance'}}">
						<i class="fa-solid fa-trash"></i>
					</button>
				</button>
				{{else}}
				<div class="editor-panel-empty">{{localize "dc-npc-patrols.quests.no_posse_quests"}}</div>
				{{/each}}
			</div>
			{{#if working_instance}}
			<div class="editor-subsection-title" style="margin-top: 10px;">{{localize "dc-npc-patrols.quests.instance_editor"}}</div>
			<p class="editor-hint dc-quest-instance-hint">{{working_instance.title}} — {{localize "dc-npc-patrols.quests.instance_hint"}}</p>
			<label class="editor-field">
				<span>{{localize "dc-npc-patrols.quests.stage"}}</span>
				<input type="number" data-quest-instance-field="stage" value="{{working_instance.stage}}" min="0" max="{{working_instance.max_stage}}" />
			</label>
			<label class="editor-field dc-quest-completed-field">
				<span>{{localize "dc-npc-patrols.quests.completed"}}</span>
				<input type="checkbox" data-quest-instance-field="completed" {{#if working_instance.completed}}checked{{/if}} />
			</label>
			<div class="editor-subsection-title">{{localize "dc-npc-patrols.quests.vars"}}</div>
			{{#each working_instance.var_fields}}
			<label class="editor-field">
				<span>{{this.key}}</span>
				{{#if (eq this.type "boolean")}}
				<input type="checkbox" data-quest-instance-var="{{this.key}}" {{#if this.value}}checked{{/if}} />
				{{else if (eq this.type "number")}}
				<input type="number" data-quest-instance-var="{{this.key}}" value="{{this.value}}" />
				{{else}}
				<input type="text" data-quest-instance-var="{{this.key}}" value="{{this.value}}" />
				{{/if}}
			</label>
			{{/each}}
			<button type="button" class="editor-add-btn dc-quest-save-btn" data-action="quest-save-instance">
				<i class="fa-solid fa-floppy-disk"></i> {{localize "dc-npc-patrols.quests.save_instance"}}
			</button>
			{{/if}}
		</div>
	</section>
</div>