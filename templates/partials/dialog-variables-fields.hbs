{{#if dialog_variable_fields.length}}
<div class="bt-variables-fields">
	{{#each dialog_variable_fields}}
	<div class="actor-flag-row flexrow" style="gap:8px; align-items:center; margin-top:8px;">
		<label>{{this.label}}{{#if this.default}} <span class="bt-var-default-hint">({{localize "dc-npc-patrols.sheet.var_default"}}: {{this.default}})</span>{{/if}}</label>
		{{#if (eq this.type "boolean")}}
		<input type="checkbox" data-dialog-var="{{this.key}}" {{#if this.checked}}checked{{/if}} />
		{{else if (eq this.type "number")}}
		<input type="number" data-dialog-var="{{this.key}}" value="{{this.value}}" placeholder="{{this.default}}" />
		{{else}}
		<input type="text" data-dialog-var="{{this.key}}" value="{{this.value}}" placeholder="{{this.default}}" />
		{{/if}}
	</div>
	{{/each}}
</div>
{{/if}}
