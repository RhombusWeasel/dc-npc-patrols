{{#if selected_node}}
<div class="dialog-detail-panel">
	<div class="dialog-detail-header">
		<span class="dialog-detail-node-name">{{selected_node.id}}</span>
		<button type="button" class="editor-asset-delete dialog-detail-delete" data-action="delete-node" title="{{localize 'dc-npc-patrols.dialog.delete_node'}}">
			<i class="fa-solid fa-trash"></i> {{localize "dc-npc-patrols.dialog.delete_node"}}
		</button>
	</div>

	{{#if selected_node.is_ref}}
	<div class="dc-dialog-ref-section">
		<div class="editor-subsection-title">{{localize "dc-npc-patrols.dialog.dialog_ref_node"}}</div>
		<p class="dc-dialog-ref-hint">{{localize "dc-npc-patrols.dialog.dialog_ref_hint"}}</p>
		<label class="editor-field">
			<span>{{localize "dc-npc-patrols.dialog.linked_fragment"}}</span>
			<select data-node-field="tree_id">
				<option value="">{{localize "dc-npc-patrols.dialog.select_fragment"}}</option>
				{{#each @root.available_fragments}}
				<option value="{{this.id}}" {{#if (eq this.id @root.selected_node.tree_id)}}selected{{/if}}>{{this.name}}</option>
				{{/each}}
			</select>
		</label>
		<label class="editor-field">
			<span>{{localize "dc-npc-patrols.dialog.return_to"}}</span>
			<select data-node-field="return_to">
				<option value="" {{#unless selected_node.return_to}}selected{{/unless}}>{{localize "dc-npc-patrols.dialog.exit_conversation"}}</option>
				{{#each @root.node_list}}
				<option value="{{this.id}}" {{#if (eq this.id @root.selected_node.return_to)}}selected{{/if}}>{{this.label}}</option>
				{{/each}}
			</select>
		</label>
	</div>
	{{else}}

	<label class="editor-field">
		<span>{{localize "dc-npc-patrols.dialog.node_id"}}</span>
		<input type="text" data-node-field="id" value="{{selected_node.id}}" />
	</label>

	<label class="editor-field">
		<span>{{localize "dc-npc-patrols.dialog.npc_text"}}</span>
		<textarea data-node-field="npc_text" rows="4">{{selected_node.npc_text}}</textarea>
	</label>

	<div class="dc-dialog-editor-flag-conditions-section">
		<div class="dc-dialog-editor-diverts-section">
			<div class="editor-subsection-title">{{localize "dc-npc-patrols.dialog.diverts"}}</div>
			<div class="dc-dialog-editor-diverts-hint">{{localize "dc-npc-patrols.dialog.diverts_hint"}}</div>
			<table class="dc-cond-table" data-node-diverts>
				<thead><tr><th class="dc-cond-col-scope">Scope</th><th>Flag</th><th class="dc-cond-col-op">Operator</th><th>Value</th><th>Go to</th><th class="dc-cond-col-order"></th><th></th></tr></thead>
				<tbody>
				{{#each selected_node.diverts}}
				<tr class="dc-dialog-editor-divert-row" data-divert-idx="{{@index}}">
					<td><select data-node-divert-cond-field="{{@index}}:0:scope" class="dc-divert-cond-scope">
						<option value="actor" {{#if (eq this.conditions.0.scope "actor")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.scope_actor"}}</option>
						<option value="posse" {{#if (eq this.conditions.0.scope "posse")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.scope_posse"}}</option>
					</select></td>
					<td><input type="text" data-node-divert-cond-field="{{@index}}:0:flag_key" value="{{this.conditions.0.flag_key}}" placeholder="{{localize 'dc-npc-patrols.dialog.flag_key'}}" class="dc-divert-cond-key" /></td>
					<td><select data-node-divert-cond-field="{{@index}}:0:operator" class="dc-divert-cond-op">
						<option value="exists" {{#if (eq this.conditions.0.operator "exists")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_exists"}}</option>
						<option value="not_exists" {{#if (eq this.conditions.0.operator "not_exists")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_not_exists"}}</option>
						<option value="equals" {{#if (eq this.conditions.0.operator "equals")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_equals"}}</option>
						<option value="not_equals" {{#if (eq this.conditions.0.operator "not_equals")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_not_equals"}}</option>
						<option value="greater" {{#if (eq this.conditions.0.operator "greater")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_greater"}}</option>
						<option value="less" {{#if (eq this.conditions.0.operator "less")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_less"}}</option>
						<option value="greater_eq" {{#if (eq this.conditions.0.operator "greater_eq")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_greater_eq"}}</option>
						<option value="less_eq" {{#if (eq this.conditions.0.operator "less_eq")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_less_eq"}}</option>
						<option value="contains" {{#if (eq this.conditions.0.operator "contains")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_contains"}}</option>
						<option value="starts_with" {{#if (eq this.conditions.0.operator "starts_with")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_starts_with"}}</option>
					</select></td>
					<td><input type="text" data-node-divert-cond-field="{{@index}}:0:expected_value" value="{{this.conditions.0.expected_value}}" placeholder="{{localize 'dc-npc-patrols.dialog.expected_value'}}" class="dc-divert-cond-val" /></td>
					<td><select data-node-divert-goto="{{@index}}">
						<option value="" {{#unless this.goto}}selected{{/unless}}>{{localize "dc-npc-patrols.dialog.else_goto_none"}}</option>
						{{#each @root.node_list}}
						<option value="{{this.id}}" {{#if (eq this.id ../this.goto)}}selected{{/if}}>{{this.label}}</option>
						{{/each}}
					</select></td>
					<td class="dc-cond-col-order">
						<button type="button" class="dc-divert-up" data-divert-up="{{@index}}" {{#if @first}}disabled{{/if}} title="Move up">▲</button>
						<button type="button" class="dc-divert-down" data-divert-down="{{@index}}" title="Move down">▼</button>
					</td>
					<td><button type="button" class="dc-divert-delete" data-divert-delete="{{@index}}" title="{{localize 'dc-npc-patrols.dialog.delete_divert'}}">
						<i class="fa-solid fa-trash"></i>
					</button></td>
				</tr>
				{{/each}}
				</tbody>
			</table>
			<button type="button" class="editor-add-btn dc-divert-add" data-action="add-node-divert">
				<i class="fa-solid fa-plus"></i> {{localize "dc-npc-patrols.dialog.add_divert"}}
			</button>
		</div>
	</div>

	<div class="dialog-responses-section">
		<div class="editor-subsection-title">{{localize "dc-npc-patrols.dialog.responses"}}</div>
		{{#each selected_node.responses}}
		<div class="dc-dialog-editor-response-row" data-response-idx="{{@index}}">
			<div class="dc-dialog-editor-response-top">
				<input type="text" data-response-field="{{@index}}:text" value="{{this.text}}" placeholder="{{localize 'dc-npc-patrols.dialog.response_text'}}" class="dc-dialog-editor-response-text-input" />
				<label class="dc-dialog-editor-once-label">
					<input type="checkbox" data-response-field="{{@index}}:once" {{#if this.once}}checked{{/if}} />
					{{localize "dc-npc-patrols.dialog.once"}}
				</label>
				<button type="button" class="dc-dialog-editor-response-delete" data-response-delete="{{@index}}" title="{{localize 'dc-npc-patrols.dialog.delete_response'}}">
					<i class="fa-solid fa-trash"></i>
				</button>
			</div>
			<div class="dc-dialog-editor-response-bottom">
				<label>{{localize "dc-npc-patrols.dialog.goto"}}
					<select data-response-field="{{@index}}:goto">
						<option value="" {{#unless this.goto}}selected{{/unless}}>{{localize "dc-npc-patrols.dialog.exit_conversation"}}</option>
						{{#each @root.node_list}}
						<option value="{{this.id}}">{{this.label}}</option>
						{{/each}}
					</select>
				</label>
				<label>{{localize "dc-npc-patrols.dialog.set_flags"}}
					<input type="text" data-response-field="{{@index}}:set_flags_text" value="{{this.set_flags_text}}" placeholder="flag1=true, flag2=1" />
				</label>
				<label class="dc-dialog-editor-set-flags-scope">
					<span>{{localize "dc-npc-patrols.dialog.scope_label"}}</span>
					<select data-response-field="{{@index}}:set_flags_scope">
						<option value="actor" {{#if (eq this.set_flags_scope "actor")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.scope_actor"}}</option>
						<option value="posse" {{#if (eq this.set_flags_scope "posse")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.scope_posse"}}</option>
					</select>
				</label>
			</div>
			<div class="dc-dialog-editor-response-conditions">
				<div class="dc-dialog-editor-conditions-label">{{localize "dc-npc-patrols.dialog.flag_conditions"}}</div>
				<table class="dc-cond-table dc-cond-table-nested" data-response-flag-conditions="{{@index}}">
					<thead><tr><th class="dc-cond-col-scope">Scope</th><th>Flag</th><th class="dc-cond-col-op">Operator</th><th>Value</th><th></th></tr></thead>
					<tbody>
					{{#each this.flag_conditions}}
					<tr class="dc-dialog-editor-flag-condition-row" data-response-flag-cond-idx="{{@../index}}:{{@index}}">
						<td><select data-response-flag-cond-field="{{@../index}}:{{@index}}:scope" class="dc-flag-cond-scope">
							<option value="actor" {{#if (eq this.scope "actor")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.scope_actor"}}</option>
							<option value="posse" {{#if (eq this.scope "posse")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.scope_posse"}}</option>
						</select></td>
						<td><input type="text" data-response-flag-cond-field="{{@../index}}:{{@index}}:flag_key" value="{{this.flag_key}}" placeholder="{{localize 'dc-npc-patrols.dialog.flag_key'}}" class="dc-flag-cond-key" /></td>
						<td><select data-response-flag-cond-field="{{@../index}}:{{@index}}:operator" class="dc-flag-cond-op">
							<option value="exists" {{#if (eq this.operator "exists")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_exists"}}</option>
							<option value="not_exists" {{#if (eq this.operator "not_exists")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_not_exists"}}</option>
							<option value="equals" {{#if (eq this.operator "equals")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_equals"}}</option>
							<option value="not_equals" {{#if (eq this.operator "not_equals")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_not_equals"}}</option>
							<option value="greater" {{#if (eq this.operator "greater")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_greater"}}</option>
							<option value="less" {{#if (eq this.operator "less")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_less"}}</option>
							<option value="greater_eq" {{#if (eq this.operator "greater_eq")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_greater_eq"}}</option>
							<option value="less_eq" {{#if (eq this.operator "less_eq")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_less_eq"}}</option>
							<option value="contains" {{#if (eq this.operator "contains")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_contains"}}</option>
							<option value="starts_with" {{#if (eq this.operator "starts_with")}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.op_starts_with"}}</option>
						</select></td>
						<td><input type="text" data-response-flag-cond-field="{{@../index}}:{{@index}}:expected_value" value="{{this.expected_value}}" placeholder="{{localize 'dc-npc-patrols.dialog.expected_value'}}" class="dc-flag-cond-val" /></td>
						<td><button type="button" class="dc-dialog-editor-flag-cond-delete" data-response-flag-cond-delete="{{@../index}}:{{@index}}" title="{{localize 'dc-npc-patrols.dialog.delete_condition'}}">
							<i class="fa-solid fa-trash"></i>
						</button></td>
					</tr>
					{{/each}}
					</tbody>
				</table>
				<button type="button" class="editor-add-btn dc-flag-cond-add" data-action="add-response-flag-cond" data-response-flag-cond-add="{{@index}}">
					<i class="fa-solid fa-plus"></i> {{localize "dc-npc-patrols.dialog.add_condition"}}
				</button>
			</div>
			<div class="dc-dialog-editor-boons" data-boon-list="{{@index}}"></div>
		</div>
		{{/each}}
		<button type="button" class="editor-add-btn" data-action="add-response">
			<i class="fa-solid fa-plus"></i> {{localize "dc-npc-patrols.dialog.add_response"}}
		</button>
	</div>
	{{/if}}
</div>
{{else if selected_tree}}
<div class="editor-panel-empty">{{localize "dc-npc-patrols.dialog.select_node"}}</div>
{{else}}
<div class="editor-panel-empty">{{localize "dc-npc-patrols.dialog.select_tree"}}</div>
{{/if}}
