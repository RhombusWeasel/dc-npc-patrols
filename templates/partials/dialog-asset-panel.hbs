<div class="dialog-asset-panel">
	<div class="editor-asset-list">
		{{#each trees}}
		<div class="editor-asset-item">
			<button type="button" data-tree-select="{{this.id}}" class="editor-asset-btn {{#if (eq this.id ../selected_tree_id)}}active{{/if}}">
				<i class="fa-solid fa-comments"></i>
				{{#if this.is_fragment}}<span class="bt-fragment-badge">{{localize "dc-npc-patrols.dialog.fragment_badge"}}</span>{{/if}}
				{{this.name}}
			</button>
			<button type="button" data-tree-delete="{{this.id}}" class="editor-asset-delete" title="{{localize 'dc-npc-patrols.dialog.delete_tree'}}">
				<i class="fa-solid fa-trash"></i>
			</button>
		</div>
		{{/each}}
	</div>
	<button type="button" data-action="add-tree" class="editor-add-btn">
		<i class="fa-solid fa-plus"></i> {{localize "dc-npc-patrols.dialog.add_tree"}}
	</button>
	<button type="button" data-action="add-fragment" class="editor-add-btn">
		<i class="fa-solid fa-puzzle-piece"></i> {{localize "dc-npc-patrols.dialog.new_fragment"}}
	</button>

	<div class="bt-io-row">
		<button type="button" data-action="export-tree" class="editor-add-btn bt-io-btn" {{#unless selected_tree_id}}disabled{{/unless}}>
			<i class="fa-solid fa-download"></i> {{localize "dc-npc-patrols.dialog.export_tree"}}
		</button>
		<button type="button" data-action="import-tree" class="editor-add-btn bt-io-btn">
			<i class="fa-solid fa-upload"></i> {{localize "dc-npc-patrols.dialog.import_tree"}}
		</button>
		<input type="file" accept=".json,application/json" data-dialog-import-input hidden />
	</div>

	{{#if selected_tree}}
	<details class="editor-asset-settings" open>
		<summary>{{localize "dc-npc-patrols.editor.tree_settings"}}</summary>
		<label class="editor-field">
			<span>{{localize "dc-npc-patrols.dialog.tree_name"}}</span>
			<input type="text" data-tree-field="name" value="{{selected_tree.name}}" />
		</label>
		<label class="editor-field">
			<span>{{localize "dc-npc-patrols.dialog.tree_desc"}}</span>
			<input type="text" data-tree-field="description" value="{{selected_tree.description}}" />
		</label>
		<label class="editor-field">
			<span>{{localize "dc-npc-patrols.editor.kind"}}</span>
			<select data-tree-field="kind">
				<option value="tree" {{#if (eq selected_kind 'tree')}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.kind_tree"}}</option>
				<option value="fragment" {{#if (eq selected_kind 'fragment')}}selected{{/if}}>{{localize "dc-npc-patrols.dialog.kind_fragment"}}</option>
			</select>
		</label>
		<label class="editor-field">
			<span>{{localize "dc-npc-patrols.dialog.root_node"}}</span>
			<select data-tree-field="root_node">
				{{#each node_list}}
				<option value="{{this.id}}" {{#if (eq this.id ../selected_tree.root_node)}}selected{{/if}}>{{this.label}}</option>
				{{/each}}
			</select>
		</label>
	</details>

	<details class="editor-asset-settings" data-settings-panel="variables">
		<summary>{{localize "dc-npc-patrols.dialog.variables"}}</summary>
		<div class="bt-variables-table">
			<div class="bt-var-row bt-var-header">
				<span>{{localize "dc-npc-patrols.dialog.variable_key"}}</span>
				<span>{{localize "dc-npc-patrols.dialog.variable_label"}}</span>
				<span>{{localize "dc-npc-patrols.dialog.variable_type"}}</span>
				<span>{{localize "dc-npc-patrols.dialog.variable_default"}}</span>
				<span></span>
			</div>
		</div>
		<button type="button" data-action="add-variable" class="editor-add-btn editor-add-btn-inline">
			<i class="fa-solid fa-plus"></i> {{localize "dc-npc-patrols.dialog.add_variable"}}
		</button>
	</details>

	{{#if fragment_count}}
	<details class="editor-asset-settings" open>
		<summary>{{localize "dc-npc-patrols.dialog.fragment_palette"}}</summary>
		<div class="bt-palette">
			<div class="bt-palette-group">
				<div class="bt-palette-chips">
					{{#each available_fragments}}
					<div class="bt-palette-chip bt-node-stripe-reference" data-palette-fragment="{{this.id}}" draggable="true" title="{{this.name}}">
						<i class="fa-solid fa-puzzle-piece"></i>
						<span>{{this.name}}</span>
					</div>
					{{/each}}
				</div>
			</div>
		</div>
	</details>
	{{/if}}

	<button type="button" data-action="add-node" class="editor-add-btn editor-add-btn-inline">
		<i class="fa-solid fa-plus"></i> {{localize "dc-npc-patrols.dialog.add_node"}}
	</button>
	{{/if}}
</div>
