<div class="hub-npc-detail">
	<div class="hub-view-header hub-npc-header">
		<h3>{{selected_actor.name}}</h3>
		<p class="hub-view-hint">{{localize "dc-npc-patrols.hub.npc_hint"}}</p>
	</div>

	<!-- Behaviour (primary) -->
	<div class="hub-npc-section hub-npc-section-primary">
		<div class="hub-npc-section-title">
			<i class="fa-solid fa-diagram-project"></i> {{localize "dc-npc-patrols.hub.section_behaviour"}}
		</div>
		<div class="hub-behaviour-row">
			<label class="hub-field-row hub-field-grow">
				<span>{{localize "dc-npc-patrols.bt.assign_bt"}}</span>
				<select data-bt-assign>
					<option value="">{{localize "dc-npc-patrols.bt.no_bt"}}</option>
					{{#each available_bts}}
					<option value="{{this.id}}" {{#if (eq this.id ../assigned_bt_id)}}selected{{/if}}>{{this.name}}</option>
					{{/each}}
				</select>
			</label>
			{{#if assigned_bt_id}}
			<button type="button" data-action="edit-assigned-bt" class="patrol-btn">
				<i class="fa-solid fa-pen"></i> {{localize "dc-npc-patrols.hub.edit_tree"}}
			</button>
			{{/if}}
		</div>
		{{#if assigned_bt_id}}
		{{#if bt_variable_fields.length}}
		<div class="hub-bt-variables hub-npc-subsection">
			<div class="hub-npc-subsection-title">{{localize "dc-npc-patrols.sheet.tree_variables"}}</div>
			{{> "modules/dc-npc-patrols/templates/partials/bt-variables-fields.hbs"}}
		</div>
		{{/if}}
		{{/if}}
	</div>
	<!-- Dialog Variables -->
	{{#if dialog_variable_fields.length}}
	<div class="hub-npc-section">
		<div class="hub-npc-section-title">
			<i class="fa-solid fa-comments"></i> {{localize "dc-npc-patrols.dialog.variables"}}
		</div>
		<div class="hub-npc-subsection">
			<div class="hub-npc-subsection-title">{{localize "dc-npc-patrols.dialog.variables"}}</div>
			{{> "modules/dc-npc-patrols/templates/partials/dialog-variables-fields.hbs"}}
		</div>
	</div>
	{{/if}}

	<!-- Token Settings -->
	{{#if token_settings}}
	<div class="hub-npc-section hub-token-settings">
		<div class="hub-npc-section-title">
			<i class="fa-solid fa-eye"></i> {{localize "dc-npc-patrols.hub.section_token_settings"}}
		</div>
		<div class="hub-token-settings-row">
			<span class="hub-token-settings-label">{{localize "dc-npc-patrols.hub.token_settings.vision_label"}}</span>
			<span class="hub-token-settings-value {{#if token_settings.sight_enabled}}hub-token-ok{{else}}hub-token-warn{{/if}}">
				{{#if token_settings.sight_enabled}}
				{{localize "dc-npc-patrols.hub.token_settings.vision_enabled"}}
				{{#if token_settings.sight_range}} ({{token_settings.sight_range}}){{/if}}
				{{else}}
				{{localize "dc-npc-patrols.hub.token_settings.vision_disabled"}}
				{{/if}}
			</span>
		</div>
		{{#if assigned_bt_id}}
		{{#if bt_vision.requires_vision}}
		<p class="hub-token-settings-note hub-token-warn-text">
			<i class="fa-solid fa-triangle-exclamation"></i> {{bt_vision_message}}
		</p>
		{{#unless vision_ok}}
		<button type="button" data-action="enable-token-vision" class="patrol-btn hub-token-fix-btn">
			<i class="fa-solid fa-eye"></i> {{localize "dc-npc-patrols.hub.token_settings.enable_vision"}}
		</button>
		{{/unless}}
		{{#if vision_needs_range}}
		<p class="hub-token-settings-note hub-token-warn-text">
			<i class="fa-solid fa-triangle-exclamation"></i> {{localize "dc-npc-patrols.hub.token_settings.vision_needs_range"}}
		</p>
		{{/if}}
		{{else}}
		<p class="hub-token-settings-note hub-token-ok-text">
			<i class="fa-solid fa-circle-check"></i> {{localize "dc-npc-patrols.hub.token_settings.vision_ok"}}
		</p>
		{{/if}}
		{{/if}}
	</div>
	{{/if}}

	<!-- Interactions -->
	<div class="hub-npc-section">
		<div class="hub-npc-section-title">
			<i class="fa-solid fa-handshake"></i> {{localize "dc-npc-patrols.hub.section_interactions"}}
		</div>
		{{> attachment-editor hub_mode=true}}
	</div>
</div>