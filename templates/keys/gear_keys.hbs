<section>
  <div class="center dc-newspaper-subhead">
    {{localize "dc.marshal.sheet.tabs.gear.tabs.keys.header"}}
    {{#is_gm}}
      <a class="add-gear center fas fa-plus" data-action="addGear" data-path="keys" title="{{localize 'dc.shared.edit'}} {{localize 'dc-npc-patrols.key.header'}}" /></a>
    {{/is_gm}}
  </div>
  <table>
    <tr>
      <th class="sort-list center" data-path="char.gear.keys" data-key="quantity">{{localize "dc.shared.quantity_short"}}</th>
      <th class="sort-list center" data-path="char.gear.keys" data-key="label">{{localize "dc.shared.name"}}</th>
      <th class="sort-list center width-10" data-path="char.gear.keys" data-key="weight" title="{{localize "dc.shared.weight"}}">
        <i class="fas fa-weight-hanging" />
      </th>
      <th class="sort-list center width-15" data-path="char.gear.keys" data-key="cost" title="{{localize "dc.shared.cost"}}">
        <i class="fas fa-dollar-sign" />
      </th>
      <th class="center width-5" title='{{localize "dc-npc-patrols.key.use_key"}}'>
        <i class="fas fa-key" />
      </th>
      {{#is_gm}}
      <th class="center width-5" title='{{localize "dc.shared.edit"}}'><i class="fas fa-pen-nib" /></th>
      <th class="center width-5" title='{{localize "dc.shared.trash"}}'><i class="fas fa-trash" /></th>
      {{else}}
      <th class="center width-5" title='{{localize "dc.shared.view"}}'><i class="fas fa-magnifying-glass" /></th>
      {{/is_gm}}
    </tr>
    {{#each actor.system.char.gear.keys as |key|}}
      <tr>
        <td class="center">{{key.count}}</td>
        <td class="left">{{key.label}}</td>
        <td class="center">{{sum key.count '*' (sum key.weight '/' key.quantity)}}</td>
        <td class="right">{{format_currency (sum key.count '*' (sum key.cost '/' key.quantity))}}</td>
        <td class="center use-key" data-action="useItem" data-path="char.gear.keys" data-key="{{@key}}">
          <a class="fas fa-key" title="{{localize 'dc-npc-patrols.key.use_key'}}: {{key.label}}" />
        </td>
        {{#is_gm}}
        <td class="center edit-path" data-action="editPath" data-path="char.gear.keys" data-key="{{@key}}">
          <a class="fas fa-pen-nib" title="{{localize 'dc.shared.edit'}} {{key.label}}" />
        </td>
        <td class="center delete-path" data-action="deletePath" data-path="char.gear.keys.{{@key}}">
          <a class="fas fa-trash" title="{{localize 'dc.shared.trash'}} {{key.label}}?" />
        </td>
        {{else}}
        <td class="center view-path" data-action="viewPath" data-path="char.gear.keys" data-key="{{@key}}">
          <a class="fas fa-magnifying-glass" title="{{localize 'dc.shared.view'}} {{key.label}}" />
        </td>
        {{/is_gm}}
      </tr>
    {{/each}}
  </table>
</section>